# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# Generate secrets with:  openssl rand -hex 32

NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPPORT_EMAIL=festora@221blabs.com
SUPPORT_EMAIL=festora@221blabs.com

# Admin console at /admin.html (server-only; never prefix with NEXT_PUBLIC_)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Signs QR tickets — never change after the first sale
TICKET_SIGNING_SECRET=

# Razorpay — Dashboard → API Keys / Webhooks (events: payment.captured, payment.failed → /api/razorpay/webhook)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase service account (Firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Preferred: base64-encode the "private_key" field from the service-account JSON
# (e.g. `node -e "console.log(Buffer.from(require('fs').readFileSync('key.json','utf8')).toString('base64'))"`
# applied to just the private_key string) and paste the result here — a flat
# one-line value with no quotes/newlines to mangle in a dashboard paste.
FIREBASE_PRIVATE_KEY_BASE64=
# Fallback if you'd rather paste the raw PEM (quotes + literal \n, as in the JSON file):
FIREBASE_PRIVATE_KEY=
FIRESTORE_COLLECTION=lowkey_tech_2026_registrations

# Resend email (primary)
RESEND_API_KEY=
MAIL_FROM=Festora <festora@221blabs.com>
ADMIN_NOTIFY_EMAIL=

# SMTP fallback — used automatically only if Resend is unset or a send fails.
# Defaults target Brevo's SMTP relay (same secondary path festora-v1 uses);
# set SMTP_HOST/SMTP_PORT instead if you use a different SMTP provider.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Festora <festora@221blabs.com>
