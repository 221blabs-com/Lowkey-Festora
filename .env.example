# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# Generate secrets with:  openssl rand -hex 32

NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPPORT_EMAIL=festora@221blabs.com
SUPPORT_EMAIL=festora@221blabs.com

# Admin console at /admin.html (server-only; never prefix with NEXT_PUBLIC_)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Signs QR tickets — never change after the first sale
TICKET_SIGNING_SECRET=

# Razorpay — Dashboard → API Keys / Webhooks (events: payment.captured, payment.failed → /api/razorpay/webhook)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase service account (Firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_COLLECTION=lowkey_tech_2026_registrations

# Resend email
RESEND_API_KEY=
MAIL_FROM=Festora <festora@221blabs.com>
ADMIN_NOTIFY_EMAIL=
